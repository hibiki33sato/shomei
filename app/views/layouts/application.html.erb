<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "BALANCEとあげ太郎を、未来につなげたい" %></title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600;700&family=Noto+Sans+JP:wght@300;400;500&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="no-print" style="text-align:right;padding:8px 20px;background:var(--warm-white);border-bottom:1px solid var(--border);">
      <%= link_to t("lang_switch"), I18n.locale == :ja ? root_path(locale: :en) : root_path(locale: :ja), style: "font-size:12px;color:var(--muted);text-decoration:none;letter-spacing:0.05em;" %>
    </div>
    <%= yield %>
  </body>
</html>
